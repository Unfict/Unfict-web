---
export interface Props {
  id: string;
  name?: string;
  type?: 'text' | 'email' | 'url' | 'tel' | 'search' | 'password';
  value?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  ariaDescribedBy?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  id,
  name,
  type = 'text',
  value,
  placeholder,
  required = false,
  disabled = false,
  ariaDescribedBy,
  class: className = '',
  ...rest
} = Astro.props;
---

<input
  id={id}
  name={name || id}
  type={type}
  value={value}
  placeholder={placeholder}
  required={required}
  disabled={disabled}
  aria-describedby={ariaDescribedBy}
  class={`uf-input ${className}`.trim()}
  data-uf-interface-owner="INPUT-01"
  data-uf-interface-status="placeholder"
  {...rest}
/>

<style>
  .uf-input {
    width: 100%;
    padding: var(--uf-spacing-2xs, 0.5rem) var(--uf-spacing-xs, 0.75rem);
    font-family: var(--unfict-font-sans, sans-serif);
    font-size: 0.875rem;
    border: 1px solid var(--unfict-color-border-gray, #dde1e7);
    border-radius: var(--uf-radius-default, 4px);
    background-color: var(--unfict-color-white, #ffffff);
    color: var(--unfict-color-deep-ink, #0a0d14);
  }

  .uf-input:disabled {
    background-color: var(--unfict-color-institutional-gray, #f6f7f9);
    cursor: not-allowed;
  }
</style>
