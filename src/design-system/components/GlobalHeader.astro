---
import NavWebPrimary, { type NavItem } from '../navigation/NavWebPrimary.astro';
import UfIcon from '../icons/components/UfIcon.astro';

export interface Props {
  navItems?: NavItem[];
  activeHref?: string;
  brandName?: string;
  class?: string;
}

const { navItems, activeHref, brandName = 'Unfict', class: className = '' } = Astro.props;
---

<header
  class={`uf-global-header ${className}`.trim()}
  data-uf-interface-owner="GLOBAL-HEADER-01"
  data-uf-interface-status="implemented"
>
  <div class="uf-global-header__inner">
    <a href="/" class="uf-global-header__brand" aria-label={`${brandName} Home`}>
      <span class="uf-global-header__brand-mark">
        <UfIcon name="motifs/uf-motif-mark" size={24} decorative={true} />
      </span>
      <span class="uf-global-header__divider" aria-hidden="true"></span>
      <span class="uf-global-header__brand-text">{brandName}</span>
      <span class="uf-global-header__tag font-mono">REALITY SYNC</span>
    </a>

    <div class="uf-global-header__nav">
      <NavWebPrimary items={navItems} activeHref={activeHref} />
    </div>
  </div>
</header>

<style>
  .uf-global-header {
    width: 100%;
    border-bottom: 1px solid var(--unfict-color-border-gray, #dde1e7);
    background-color: var(--unfict-color-white, #ffffff);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .uf-global-header__inner {
    max-width: var(--uf-width-wide, 1200px);
    margin: 0 auto;
    padding: var(--uf-spacing-2xs, 0.5rem) var(--uf-spacing-sm, 1rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
  }

  .uf-global-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--unfict-color-deep-ink, #0a0d14);
  }

  .uf-global-header__brand-mark {
    display: flex;
    align-items: center;
    color: var(--unfict-color-blue, #1965ec);
    margin-right: var(--uf-spacing-2xs, 0.5rem);
  }

  .uf-global-header__divider {
    display: inline-block;
    width: 1px;
    height: 1rem;
    background-color: var(--unfict-color-border-gray, #dde1e7);
    margin-right: var(--uf-spacing-2xs, 0.5rem);
  }

  .uf-global-header__brand-text {
    font-family: var(--unfict-font-sans, sans-serif);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--unfict-color-deep-ink, #0a0d14);
  }

  .uf-global-header__tag {
    font-family: var(--unfict-font-mono, monospace);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--unfict-color-slate, #596273);
    padding-left: var(--uf-spacing-2xs, 0.5rem);
    margin-left: var(--uf-spacing-2xs, 0.5rem);
    border-left: 1px solid var(--unfict-color-border-gray, #dde1e7);
  }

  @media (max-width: 640px) {
    .uf-global-header__tag {
      display: none;
    }
  }
</style>
