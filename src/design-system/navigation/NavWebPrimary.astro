---
export interface NavItem {
  label: string;
  href: string;
  isCta?: boolean;
}

export interface Props {
  items?: NavItem[];
  activeHref?: string;
  class?: string;
}

const defaultItems: NavItem[] = [
  { label: 'GS1 Digital Link', href: '/gs1-digital-link' },
  { label: 'Developers', href: '/developers' },
  { label: 'Insights', href: '/insights' },
  { label: 'About', href: '/about' },
  { label: 'Request developer preview', href: '/early-access', isCta: true }
];

const { items = defaultItems, activeHref, class: className = '' } = Astro.props;
---

<nav
  class={`uf-nav-primary ${className}`.trim()}
  aria-label="Primary"
  data-uf-interface-owner="NAV-WEB-PRIMARY-01"
  data-uf-interface-status="placeholder"
>
  <ul class="uf-nav-primary__list">
    {
      items.map((item) => (
        <li class="uf-nav-primary__item">
          <a
            href={item.href}
            class={`uf-nav-primary__link ${item.isCta ? 'uf-nav-primary__link--cta' : ''} ${
              activeHref === item.href ? 'uf-nav-primary__link--active' : ''
            }`.trim()}
            aria-current={activeHref === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .uf-nav-primary__list {
    display: flex;
    align-items: center;
    gap: var(--uf-spacing-md, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .uf-nav-primary__link {
    font-family: var(--unfict-font-sans, sans-serif);
    font-size: 0.875rem;
    color: var(--unfict-color-deep-ink, #0a0d14);
    text-decoration: none;
    font-weight: 500;
  }

  .uf-nav-primary__link--active {
    text-decoration: underline;
  }

  .uf-nav-primary__link--cta {
    padding: var(--uf-spacing-2xs, 0.5rem) var(--uf-spacing-xs, 0.75rem);
    border: 1px solid var(--unfict-color-border-gray, #dde1e7);
    border-radius: var(--uf-radius-default, 4px);
    background-color: var(--unfict-color-institutional-gray, #f6f7f9);
  }
</style>
