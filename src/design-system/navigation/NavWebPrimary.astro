---
import Button from '../primitives/Button.astro';

export interface NavItem {
  label: string;
  href: string;
  isCta?: boolean;
}

export interface Props {
  items?: NavItem[];
  activeHref?: string;
  class?: string;
}

const defaultItems: NavItem[] = [
  { label: 'GS1 Digital Link', href: '/gs1-digital-link' },
  { label: 'Developers', href: '/developers' },
  { label: 'Insights', href: '/insights' },
  { label: 'About', href: '/about' },
  { label: 'Request developer preview', href: '/early-access', isCta: true }
];

const { items = defaultItems, activeHref, class: className = '' } = Astro.props;
---

<nav
  class={`uf-nav-primary ${className}`.trim()}
  aria-label="Primary"
  data-uf-interface-owner="NAV-WEB-PRIMARY-01"
  data-uf-interface-status="implemented"
>
  <ul class="uf-nav-primary__list">
    {
      items.map((item) => (
        <li class="uf-nav-primary__item">
          {item.isCta ? (
            <Button href={item.href} variant="primary">
              {item.label}
            </Button>
          ) : (
            <a
              href={item.href}
              class={`uf-nav-primary__link ${
                activeHref === item.href ? 'uf-nav-primary__link--active' : ''
              }`.trim()}
              aria-current={activeHref === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .uf-nav-primary__list {
    display: flex;
    align-items: center;
    gap: var(--uf-spacing-md, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .uf-nav-primary__link {
    font-family: var(--unfict-font-sans, sans-serif);
    font-size: 0.875rem;
    color: var(--unfict-color-slate, #596273);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease-in-out;
  }

  .uf-nav-primary__link:hover,
  .uf-nav-primary__link--active {
    color: var(--unfict-color-deep-ink, #0a0d14);
  }

  .uf-nav-primary__link--active {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
