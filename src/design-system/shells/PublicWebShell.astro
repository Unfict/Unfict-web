---
import GlobalHeader from '../components/GlobalHeader.astro';
import GlobalFooter from '../components/GlobalFooter.astro';
import type { NavItem } from '../navigation/NavWebPrimary.astro';

export interface Props {
  navItems?: NavItem[];
  activeHref?: string;
  brandName?: string;
  copyright?: string;
  class?: string;
}

const { navItems, activeHref, brandName, copyright, class: className = '' } = Astro.props;
---

<div
  class={`uf-shell-public-web ${className}`.trim()}
  data-uf-interface-owner="SHELL-WEB-PUBLIC-01"
  data-uf-interface-status="implemented"
>
  <a href="#main-content" class="uf-shell-public-web__skip-link"> Skip to main content </a>

  <GlobalHeader navItems={navItems} activeHref={activeHref} brandName={brandName} />

  <main id="main-content" class="uf-shell-public-web__main">
    <slot />
  </main>

  <GlobalFooter copyright={copyright} />
</div>

<style>
  .uf-shell-public-web {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: var(--unfict-color-white, #ffffff);
  }

  .uf-shell-public-web__skip-link {
    position: absolute;
    top: -9999px;
    left: 1rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background-color: var(--unfict-color-deep-ink, #0a0d14);
    color: var(--unfict-color-white, #ffffff);
    font-family: var(--unfict-font-sans, sans-serif);
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: var(--uf-radius-default, 4px);
  }

  .uf-shell-public-web__skip-link:focus {
    top: 1rem;
  }

  .uf-shell-public-web__main {
    flex: 1;
    width: 100%;
  }
</style>
