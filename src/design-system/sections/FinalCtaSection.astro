---
import FinalCta from '../patterns/FinalCta.astro';
import type { ActionProp } from '../patterns/ActionHero.astro';

export interface Props {
  heading: string;
  subheading?: string;
  primaryAction: ActionProp;
  class?: string;
}

const { heading, subheading, primaryAction, class: className = '' } = Astro.props;
---

<section
  class={`uf-section-final-cta ${className}`.trim()}
  data-uf-interface-owner="SECTION-FINAL-CTA-01"
  data-uf-interface-status="placeholder"
>
  <div class="uf-section-final-cta__inner">
    <FinalCta heading={heading} subheading={subheading} primaryAction={primaryAction} />
  </div>
</section>

<style>
  .uf-section-final-cta {
    padding: var(--uf-spacing-2xl, 4rem) var(--uf-spacing-sm, 1rem);
  }

  .uf-section-final-cta__inner {
    max-width: var(--uf-width-standard, 960px);
    margin: 0 auto;
  }
</style>
