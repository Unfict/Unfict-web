---
import ConceptFlow, { type ConceptStep } from '../patterns/ConceptFlow.astro';

export interface Props {
  title?: string;
  steps: ConceptStep[];
  class?: string;
}

const { title = 'Conceptual Model', steps, class: className = '' } = Astro.props;
---

<section
  class={`uf-section-conceptual-model ${className}`.trim()}
  data-uf-interface-owner="SECTION-CONCEPTUAL-MODEL-01"
  data-uf-interface-status="placeholder"
>
  <div class="uf-section-conceptual-model__inner">
    <ConceptFlow title={title} steps={steps} />
  </div>
</section>

<style>
  .uf-section-conceptual-model {
    padding: var(--uf-spacing-xl, 3rem) var(--uf-spacing-sm, 1rem);
    background-color: var(--unfict-color-institutional-gray, #f6f7f9);
    border-top: 1px solid var(--unfict-color-border-gray, #dde1e7);
    border-bottom: 1px solid var(--unfict-color-border-gray, #dde1e7);
  }

  .uf-section-conceptual-model__inner {
    max-width: var(--uf-width-standard, 960px);
    margin: 0 auto;
  }
</style>
