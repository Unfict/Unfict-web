---
import Button from '../primitives/Button.astro';
import TextLink from '../primitives/TextLink.astro';
import { isPlaceholderOwner } from '../registry/interface-runtime-state';

export interface ActionProp {
  label: string;
  href: string;
}

export interface Props {
  heading: string;
  eyebrow?: string;
  lead?: string;
  primaryAction: ActionProp;
  secondaryAction?: ActionProp;
  theme?: 'light' | 'dark';
  class?: string;
}

const {
  eyebrow,
  heading,
  lead,
  primaryAction,
  secondaryAction,
  theme = 'light',
  class: className = ''
} = Astro.props;

const isPlaceholder = isPlaceholderOwner('PATTERN-HERO-ACTION-01');
---

<div
  class={`uf-pattern-action-hero uf-pattern-action-hero--${theme} ${className}`.trim()}
  data-uf-interface-owner="PATTERN-HERO-ACTION-01"
  data-uf-interface-status={isPlaceholder ? 'placeholder' : 'implemented'}
>
  {eyebrow && <div class="uf-pattern-action-hero__eyebrow">{eyebrow}</div>}
  <h1 class="uf-pattern-action-hero__heading">{heading}</h1>
  {lead && <p class="uf-pattern-action-hero__lead">{lead}</p>}
  <div class="uf-pattern-action-hero__actions">
    <Button variant="primary" href={primaryAction.href}>
      {primaryAction.label}
    </Button>
    {
      secondaryAction && (
        <TextLink href={secondaryAction.href} class="uf-pattern-action-hero__secondary-link">
          {secondaryAction.label}
        </TextLink>
      )
    }
  </div>
</div>

<style>
  .uf-pattern-action-hero {
    display: flex;
    flex-direction: column;
    gap: var(--uf-spacing-sm, 1rem);
  }

  .uf-pattern-action-hero__eyebrow {
    font-family: var(--unfict-font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .uf-pattern-action-hero--light .uf-pattern-action-hero__eyebrow {
    color: var(--unfict-color-slate, #596273);
  }

  .uf-pattern-action-hero--dark .uf-pattern-action-hero__eyebrow {
    color: var(--unfict-color-border-gray, #dde1e7);
  }

  .uf-pattern-action-hero__heading {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }

  .uf-pattern-action-hero--light .uf-pattern-action-hero__heading {
    color: var(--unfict-color-deep-ink, #0a0d14);
  }

  .uf-pattern-action-hero--dark .uf-pattern-action-hero__heading {
    color: var(--unfict-color-white, #ffffff);
  }

  .uf-pattern-action-hero__lead {
    font-size: 1.125rem;
    line-height: 1.5;
    margin: 0;
  }

  .uf-pattern-action-hero--light .uf-pattern-action-hero__lead {
    color: var(--unfict-color-slate, #596273);
  }

  .uf-pattern-action-hero--dark .uf-pattern-action-hero__lead {
    color: var(--unfict-color-border-gray, #dde1e7);
  }

  .uf-pattern-action-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--uf-spacing-md, 1.5rem);
    margin-top: var(--uf-spacing-2xs, 0.5rem);
  }

  .uf-pattern-action-hero__secondary-link {
    font-size: 0.875rem;
  }

  .uf-pattern-action-hero--dark :global(.uf-pattern-action-hero__secondary-link) {
    color: var(--unfict-color-white, #ffffff);
  }

  .uf-pattern-action-hero--dark :global(.uf-pattern-action-hero__secondary-link:hover) {
    color: var(--unfict-color-border-gray, #dde1e7);
  }
</style>
