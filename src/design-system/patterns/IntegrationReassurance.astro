---
export interface IntegrationPoint {
  title: string;
  description: string;
}

export interface Props {
  title?: string;
  points: IntegrationPoint[];
  class?: string;
}

const { title = 'System Integration', points, class: className = '' } = Astro.props;
---

<div
  class={`uf-pattern-integration-reassurance ${className}`.trim()}
  data-uf-interface-owner="PATTERN-INTEGRATION-REASSURANCE-01"
  data-uf-interface-status="placeholder"
>
  {title && <h3 class="uf-pattern-integration-reassurance__title">{title}</h3>}
  <div class="uf-pattern-integration-reassurance__points">
    {
      points.map((point) => (
        <div class="uf-pattern-integration-reassurance__point">
          <h4 class="uf-pattern-integration-reassurance__point-title">{point.title}</h4>
          <p class="uf-pattern-integration-reassurance__point-desc">{point.description}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .uf-pattern-integration-reassurance {
    display: flex;
    flex-direction: column;
    gap: var(--uf-spacing-sm, 1rem);
  }

  .uf-pattern-integration-reassurance__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }

  .uf-pattern-integration-reassurance__points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--uf-spacing-md, 1.5rem);
  }

  .uf-pattern-integration-reassurance__point {
    padding: var(--uf-spacing-sm, 1rem);
    border: 1px solid var(--unfict-color-border-gray, #dde1e7);
    border-radius: var(--uf-radius-default, 4px);
  }

  .uf-pattern-integration-reassurance__point-title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0 0 var(--uf-spacing-3xs, 0.25rem) 0;
  }

  .uf-pattern-integration-reassurance__point-desc {
    font-size: 0.8125rem;
    color: var(--unfict-color-slate, #596273);
    margin: 0;
  }
</style>
