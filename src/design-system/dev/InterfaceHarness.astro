---
import { HARNESS_FIXTURES } from './harness-fixtures';
import Button from '../primitives/Button.astro';
import TextLink from '../primitives/TextLink.astro';
import IconButton from '../primitives/IconButton.astro';
import CodeInline from '../primitives/CodeInline.astro';
import FaqItem from '../components/FaqItem.astro';
import ActionHero from '../patterns/ActionHero.astro';
import ConceptFlow from '../patterns/ConceptFlow.astro';
import FinalCta from '../patterns/FinalCta.astro';
---

<div class="uf-harness-inspector">
  <div class="uf-harness-notice">
    <strong>{HARNESS_FIXTURES.notice}</strong>
  </div>

  <section class="uf-harness-section">
    <h2>1. Primitives Inspection</h2>
    <div class="uf-harness-grid">
      <div>
        <h3>BUTTON-PRIMARY-01</h3>
        <Button variant="primary">Primary Action</Button>
      </div>
      <div>
        <h3>BUTTON-SECONDARY-01</h3>
        <Button variant="secondary">Secondary Action</Button>
      </div>
      <div>
        <h3>TEXT-LINK-01</h3>
        <TextLink href="#">Sample Text Link</TextLink>
      </div>
      <div>
        <h3>ICON-BUTTON-01</h3>
        <IconButton icon="search" label="Search" />
      </div>
      <div>
        <h3>CODE-INLINE-01</h3>
        <CodeInline>npm run build</CodeInline>
      </div>
    </div>
  </section>

  <section class="uf-harness-section">
    <h2>2. Components & Patterns Inspection</h2>
    <div>
      <h3>FAQ-ITEM-01</h3>
      <FaqItem
        id={HARNESS_FIXTURES.faqItems[0].id}
        question={HARNESS_FIXTURES.faqItems[0].question}
        directAnswer={HARNESS_FIXTURES.faqItems[0].directAnswer}
      />
    </div>

    <div>
      <h3>PATTERN-HERO-ACTION-01</h3>
      <ActionHero
        heading={HARNESS_FIXTURES.heroData.heading}
        lead={HARNESS_FIXTURES.heroData.lead}
        primaryAction={HARNESS_FIXTURES.heroData.primaryAction}
        secondaryAction={HARNESS_FIXTURES.heroData.secondaryAction}
      />
    </div>

    <div>
      <h3>PATTERN-CONCEPT-FLOW-01</h3>
      <ConceptFlow steps={[...HARNESS_FIXTURES.conceptSteps]} />
    </div>

    <div>
      <h3>PATTERN-FINAL-CTA-01</h3>
      <FinalCta
        heading={HARNESS_FIXTURES.finalCtaData.heading}
        subheading={HARNESS_FIXTURES.finalCtaData.subheading}
        primaryAction={HARNESS_FIXTURES.finalCtaData.primaryAction}
      />
    </div>
  </section>
</div>

<style>
  .uf-harness-inspector {
    padding: 2rem;
    font-family: var(--unfict-font-sans, sans-serif);
    background-color: var(--unfict-color-white, #ffffff);
  }

  .uf-harness-notice {
    padding: 1rem;
    background-color: var(--unfict-color-institutional-gray, #f6f7f9);
    border: 1px dashed var(--unfict-color-border-gray, #dde1e7);
    margin-bottom: 2rem;
    font-family: var(--unfict-font-mono, monospace);
    text-align: center;
  }

  .uf-harness-section {
    margin-bottom: 3rem;
  }

  .uf-harness-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }
</style>
